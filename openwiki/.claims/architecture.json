    {
      "id": "claim_83d16f65278d4cda9e558ffb8ab1ce90",
      "statement": "consumeFragmentToken() in app.ts parses #access_token from the URL hash, calls setToken() and scheduleRefresh(), reads ?flow=signup to set the justSignedUp signal for the welcome banner, and clears both from the URL via history.replaceState().",
      "evidence": [
        {
          "resource": "repo://src/app/app.ts#L16-L39",
          "version": "repo-lines-v1:sha256:0b346056ea53486288503bc368b0b08662825c83edf531b57abba56e0cb99c25:"
        }
      ]
    },
    {
      "id": "claim_f92d2aafef754de29a4f35f3acbace4f",
      "statement": "The justSignedUp signal is a one-shot flag set from the ?flow=signup query param on the backend's redirect after fresh signup (email verification or OAuth), read once by the Shell component for the welcome banner, then reset — never persisted.",
      "evidence": [
        {
          "resource": "repo://src/app/just-signed-up.ts",
