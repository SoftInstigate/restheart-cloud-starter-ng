    {
      "id": "claim_aa63b786bde44810a844bbc20b329b4a",
      "statement": "Two guards from @restheart-cloud/kit-ng protect routes: authGuard runs checkSession and redirects to /auth/login if no user, while publicGuard redirects signed-in users away from auth pages. The /invitations/accept route is deliberately unguarded.",
