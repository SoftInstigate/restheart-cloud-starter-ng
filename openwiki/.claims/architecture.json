    {
      "id": "claim_56983158f3144ccb8ddfb42d38505dff",
      "statement": "Routes are conditionally included based on feature flags (emailRegistration, passwordReset, oauthLogin, teamInvitations) from environment.features; a flag that's off removes the route entirely.",
      "evidence": [
        {
          "resource": "repo://src/app/app.routes.ts#L21-L22",
