    {
      "id": "claim_7fe2f18eb7cd4852ab8b8daf61195452",
      "statement": "SSR render modes are defined in app.routes.server.ts: auth pages (login, signup, forgot/reset password) use Prerender for static HTML, while verify, invitations, and all authenticated routes use Client mode rendered in browser only.",
