    {
      "id": "claim_c8bc56748ad748a3a715539a5c995a4a",
      "statement": "Two environment files control API configuration: environment.dev.ts for local development (ng serve) and environment.ts for production builds (ng build). The apiUrl must be a *.restheart.com URL or the app shows a 'Connect your service' screen. Feature flags must match the RESTHeart Cloud service's Sign-up Mgmt → Features toggles to avoid 403 errors.",
      "evidence": [
        {
          "resource": "repo://src/app/app.html#L3-L62",
