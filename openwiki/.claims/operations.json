    {
      "id": "claim_6f1b662867fe42cd8fd78804832ebb59",
      "statement": "The project uses npm for dependency management and Angular CLI for development commands: npm install, ng serve (dev server on localhost:4200), ng build (production build), ng build --watch --configuration development (watch mode), and ng test (run tests).",
      "evidence": [
